#!/usr/bin/env python3
import json, os, sqlite3, sys

args = json.load(sys.stdin)
db = sqlite3.connect(os.environ["AGENT_DB"])
try:
    if args.get("action") == "add":
        text = (args.get("text") or "").strip()
        if not text:
            print(json.dumps({"ok": False, "error": "text is required"})); sys.exit(0)
        db.execute("insert into notes_items(text, session) values(?,?)",
                   (text, os.environ.get("AGENT_SESSION")))
        db.commit()
        print(json.dumps({"ok": True, "content": "noted"}))
    else:
        rows = db.execute("select id, text, created_at from notes_items order by id desc limit 50").fetchall()
        body = "\n".join(f"{r[0]}. {r[1]}  ({r[2]})" for r in rows) or "no notes"
        print(json.dumps({"ok": True, "content": body}))
finally:
    db.close()
