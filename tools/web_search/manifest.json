{
  "name": "web_search",
  "description": "Search the web in a headless browser and return result titles, URLs, and snippets.",
  "db_prefix": "web_search_",
  "env": [
    "AGENT_BROWSER",
    "AGENT_NO_BROWSER",
    "PLAYWRIGHT_BROWSERS_PATH"
  ],
  "timeout_seconds": 60,
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Search query."
      },
      "limit": {
        "type": "integer",
        "description": "Maximum results, default 10."
      }
    },
    "required": [
      "query"
    ]
  }
}
