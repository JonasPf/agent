# Copy to .env and fill in. The agent reads this file at startup.
# A variable already set in the environment overrides the value here.
# Keep .env mode 600; it is gitignored.
#
# Every setting the agent reads is listed below, with its default. That is
# checked by a test rather than kept up by hand: a setting missing from here is
# one nobody can find, and one listed here that nothing reads is worse, because
# changing it appears to do something.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

OPENROUTER_API_KEY=sk-or-...

# ---------------------------------------------------------------------------
# Where things are. Defaults are relative to the working directory; the image
# sets them under /app/state, which is the one volume a deployment mounts.
# ---------------------------------------------------------------------------

# The file these settings are read from. Read before anything else, so it only
# has an effect when set in the real environment.
# AGENT_ENV=.env

# Transcripts, one directory per session, and the database under db/.
# AGENT_DATA=data

# One working directory per session: what that session's tools can write.
# AGENT_WORKSPACE=workspace

# Scanned at startup and on reload_tools.
# AGENT_TOOLS=tools
# AGENT_SKILLS=skills

# The browser interface, served as static files.
# AGENT_WEB=web

# What changed, shown beside the running version under More -> version.
# AGENT_CHANGELOG=CHANGELOG.md

# ---------------------------------------------------------------------------
# Serving and models
# ---------------------------------------------------------------------------

# AGENT_ADDR=:8080

# The model a new session starts on. Each session then keeps its own for life.
# AGENT_MODEL=anthropic/claude-sonnet-4.5

# The model `task eval` puts each tool's eval.json cases to. Costs money. A run
# against a model the gateway no longer lists says so rather than failing every
# case.
# AGENT_EVAL_MODEL=google/gemma-4-26b-a4b-it

# ---------------------------------------------------------------------------
# How much conversation is kept
# ---------------------------------------------------------------------------

# The projected size at which a conversation compacts in place.
# AGENT_COMPACT_TOKENS=40000

# How much of the tail a compaction leaves untouched, word for word.
# AGENT_KEEP_TOKENS=10000

# How often, in tokens of growth, the running summary is rewritten.
# AGENT_SUMMARY_EVERY=4000

# Characters of durable memory carried in every prompt.
# AGENT_MEMORY_CAPACITY=8000

# ---------------------------------------------------------------------------
# The sandbox
# ---------------------------------------------------------------------------

# A tool reads and writes its own session's working directory and nothing else.
# Name any extra directory it may READ here, separated by ':'. It only adds —
# there is no setting that turns the boundary off. The browser needs nothing
# here: it is installed at /usr/bin/chromium, under a path already granted.
# AGENT_READ_PATHS=/opt/something

# ---------------------------------------------------------------------------
# Credentials a session can be granted
#
# These are not settings the agent acts on. They sit here so the values exist
# where the agent runs; a tool receives one only in a session granted it by
# name, under Controls -> granted environment. Setting them here alone changes
# nothing, which is deliberate.
# ---------------------------------------------------------------------------

# Clone URL of this repository, for the agent to propose changes to itself.
# AGENT_REPO=https://x-access-token:<token>@github.com/<owner>/agent.git

# Fine-grained, one repository, contents + pull requests write, no workflow
# scope. The most it can do with this is open a pull request nobody has merged.
# GH_TOKEN=github_pat_...

# ---------------------------------------------------------------------------
# Not settings: AGENT_URL, AGENT_SESSION, AGENT_JOB, AGENT_DB, AGENT_DB_PREFIX
# and TMPDIR are set by the agent for each tool subprocess. Setting them here
# does nothing; the agent overwrites them on every call.
# ---------------------------------------------------------------------------
