# Copy to .env and fill in. The agent reads this file at startup.
# A variable already set in the environment overrides the value here.
# Keep .env mode 600; it is gitignored.

OPENROUTER_API_KEY=sk-or-...

# Optional. Defaults are in the README.
# AGENT_ADDR=:8080
# AGENT_MODEL=anthropic/claude-sonnet-4.5

# A tool reads and writes its own session's working directory and nothing else.
# Name any extra directory it may READ here, separated by ':'. A headless
# browser installed outside the system paths is the case this exists for; in a
# container with chromium at /usr/bin it is unnecessary. It only adds — there is
# no setting that turns the boundary off.
# AGENT_READ_PATHS=~/Library/Caches/ms-playwright
